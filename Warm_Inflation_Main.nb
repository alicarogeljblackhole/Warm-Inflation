        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"findBracket", "[", 
            RowBox[{
            "ratio", ",", "whentofinish", ",", "tmatch", ",", "kastep"}], 
            "]"}]}]}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
