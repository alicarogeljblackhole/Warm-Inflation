       RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "]"}], "[", "t", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
