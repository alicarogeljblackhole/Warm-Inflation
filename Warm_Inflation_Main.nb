Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"finds", " ", "an", " ", "interval", " ", "in", " ", "which", " ", 
     RowBox[{"a", " ", "'"}], 
     RowBox[{"function", "'"}], " ", 
     RowBox[{"(", 
      RowBox[{"such", " ", "as", " ", 
       RowBox[{"k", "/", 
        RowBox[{"(", 
         RowBox[{"a", " ", "H"}], ")"}]}]}], ")"}], "  ", "obtains", " ", 
     RowBox[{"its", " ", "'"}], 
     RowBox[{"target", "'"}], " ", "value"}], ",", " ", 
    RowBox[{
     RowBox[{
     "provided", " ", "this", " ", "value", " ", "is", " ", "achieved", " ", 
      "after", " ", 
      RowBox[{"time", " ", "'"}], 
      RowBox[{"tinit", "'"}]}], ";", " ", 
     RowBox[{
     "searching", " ", "for", " ", "that", " ", "interval", " ", "is", " ", 
      "done", " ", "in", " ", "the", " ", "increments", " ", 
      RowBox[{"of", " ", "'"}], 
      RowBox[{"step", "'"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"findBracket", "[", 
     RowBox[{"func_", ",", "target_", ",", "tinit_", ",", "step_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t1", "=", "tinit"}], ",", 
        RowBox[{"t2", "=", "tinit"}], ",", "v1", ",", "v2"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "v1", " ", "will", " ", "be", " ", "the", " ", "value", " ", "of", " ",
         "function", " ", "at", " ", "the", " ", "time", " ", "we", " ", 
        "start", " ", "the", " ", "computation"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"v1", "=", 
        RowBox[{"func", "[", "t1", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "v2", " ", "will", " ", "be", " ", "the", " ", "value", " ", "of", " ",
          "function", " ", "at", " ", "a", " ", "later", " ", "time"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"v2", "=", "v1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"v1", "-", "target"}], "]"}], "==", 
          RowBox[{"Sign", "[", 
           RowBox[{"v2", "-", "target"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"t2", "+=", "step"}], ";", "\[IndentingNewLine]", 
          RowBox[{"v2", "=", 
           RowBox[{"func", "[", "t2", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "stop", " ", "computation", " ", "when", " ", "function", " ", 
            "crosses", " ", "the", " ", "target", " ", "value"}], "*)"}], 
          "\[IndentingNewLine]", " ", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "in", " ", "case", " ", "something", " ", "goes", " ", "wrong"}], 
            ",", " ", 
            RowBox[{
            "the", " ", "code", " ", "should", " ", "not", " ", "run", " ", 
             "indefinitely"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "t2", "]"}], ">", "te"}], ",", 
            RowBox[{"Break", "[", "]"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"save", " ", "the", " ", "interval", " ", "of", " ", 
         RowBox[{"size", " ", "'"}], 
         RowBox[{"step", "'"}], " ", "in", " ", "which", " ", "function", " ",
          "obtains", " ", "the", " ", "target", " ", "value"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t2", "-", "step"}], ",", "t2"}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ratio", "[", "t_", "]"}], ":=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"kabck", "[", "t", "]"}], "/", 
      RowBox[{"Hbck", "[", "t", "]"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "find", " ", "the", " ", "exact", " ", "values", " ", "with", " ", 
      "FindRoot"}], ",", " ", 
     RowBox[{
     "based", " ", "on", " ", "the", " ", "interval", " ", "from", " ", 
      "findBracket"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"start", " ", "power", " ", "spectrum", " ", "evolution"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ti", "=", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ratio", "[", "t", "]"}], "==", "whentostart"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"findBracket", "[", 
            RowBox[{"ratio", ",", "whentostart", ",", "kastarttime", ",", 
             RowBox[{"2", " ", "kastep"}]}], "]"}]}]}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"horizon", " ", "exit"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tmatch", "=", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ratio", "[", "t", "]"}], "==", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"findBracket", "[", 
            RowBox[{"ratio", ",", "1", ",", "ti", ",", "kastep"}], "]"}]}]}], 
         "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"end", " ", "power", " ", "spectrum", " ", "evolution"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tf", "=", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
