    RowBox[{"10", "^", 
     RowBox[{"(", "tilt", ")"}]}], " ", 
    RowBox[{"kabck", "/@", "times"}]}]}], 
  RowBox[{"(*", 
   RowBox[{"slightly", " ", "larger", " ", 
    RowBox[{"k", "/", "a"}]}], "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kasm", "=", 
   RowBox[{
    RowBox[{"10", "^", 
     RowBox[{"(", 
      RowBox[{"-", "tilt"}], ")"}]}], " ", 
    RowBox[{"kabck", "/@", "times"}]}]}], 
  RowBox[{"(*", 
   RowBox[{"slightly", " ", "smaller", " ", 
    RowBox[{"k", "/", "a"}]}], "*)"}], ";"}]}], "Input",
