    RowBox[{"kabck", "/@", "times"}]}]}], 
  RowBox[{"(*", 
   RowBox[{"slightly", " ", "smaller", " ", 
    RowBox[{"k", "/", "a"}]}], "*)"}], ";"}]}], "Input",
