Cell[TextData[{
 "Find time at which to start (ti) and end (tf) the perturbative evolution, \
as well as the time of the horizon crossing (tmatch).\n",
 StyleBox["The  cells below first tries to find approximate times, and then \
finds the exact values. That is because FindRoot is very slow if we do not \
provide a narrow interval in which the root is suppose to lie.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.952508062355854*^9, 3.952508145089174*^9}, {
  3.952508175473284*^9, 3.952508330477824*^9}, {3.9558017730561113`*^9, 
  3.955801825911108*^9}, {3.9558021812964473`*^9, 3.955802270918602*^9}, {
  3.987160751825152*^9, 3.9871607792795258`*^9}, {3.987160840198819*^9, 
  3.987160865942279*^9}, {3.98716094171692*^9, 3.987161029987656*^9}, {
  3.987161135584799*^9, 3.987161202583857*^9}, {3.9871622237725897`*^9, 
  3.987162365137495*^9}, {3.987163946235766*^9, 
  3.987163948395775*^9}},ExpressionUUID->"b107f2d5-b1b1-4886-ac57-\
75c6d1ad8364"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"finds", " ", "an", " ", "interval", " ", "in", " ", "which", " ", 
     RowBox[{"a", " ", "'"}], 
     RowBox[{"function", "'"}], " ", 
     RowBox[{"(", 
      RowBox[{"such", " ", "as", " ", 
       RowBox[{"k", "/", 
        RowBox[{"(", 
         RowBox[{"a", " ", "H"}], ")"}]}]}], ")"}], "  ", "obtains", " ", 
     RowBox[{"its", " ", "'"}], 
     RowBox[{"target", "'"}], " ", "value"}], ",", " ", 
    RowBox[{
     RowBox[{
     "provided", " ", "this", " ", "value", " ", "is", " ", "achieved", " ", 
      "after", " ", 
      RowBox[{"time", " ", "'"}], 
      RowBox[{"tinit", "'"}]}], ";", " ", 
     RowBox[{
     "searching", " ", "for", " ", "that", " ", "interval", " ", "is", " ", 
      "done", " ", "in", " ", "the", " ", "increments", " ", 
      RowBox[{"of", " ", "'"}], 
      RowBox[{"step", "'"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"findBracket", "[", 
     RowBox[{"func_", ",", "target_", ",", "tinit_", ",", "step_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t1", "=", "tinit"}], ",", 
        RowBox[{"t2", "=", "tinit"}], ",", "v1", ",", "v2"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "v1", " ", "will", " ", "be", " ", "the", " ", "value", " ", "of", " ",
         "function", " ", "at", " ", "the", " ", "time", " ", "we", " ", 
        "start", " ", "the", " ", "computation"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"v1", "=", 
        RowBox[{"func", "[", "t1", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "v2", " ", "will", " ", "be", " ", "the", " ", "value", " ", "of", " ",
          "function", " ", "at", " ", "a", " ", "later", " ", "time"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"v2", "=", "v1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", 
           RowBox[{"v1", "-", "target"}], "]"}], "==", 
          RowBox[{"Sign", "[", 
           RowBox[{"v2", "-", "target"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"t2", "+=", "step"}], ";", "\[IndentingNewLine]", 
          RowBox[{"v2", "=", 
           RowBox[{"func", "[", "t2", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "stop", " ", "computation", " ", "when", " ", "function", " ", 
            "crosses", " ", "the", " ", "target", " ", "value"}], "*)"}], 
          "\[IndentingNewLine]", " ", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "in", " ", "case", " ", "something", " ", "goes", " ", "wrong"}], 
            ",", " ", 
            RowBox[{
            "the", " ", "code", " ", "should", " ", "not", " ", "run", " ", 
             "indefinitely"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "t2", "]"}], ">", "te"}], ",", 
            RowBox[{"Break", "[", "]"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"save", " ", "the", " ", "interval", " ", "of", " ", 
         RowBox[{"size", " ", "'"}], 
         RowBox[{"step", "'"}], " ", "in", " ", "which", " ", "function", " ",
          "obtains", " ", "the", " ", "target", " ", "value"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t2", "-", "step"}], ",", "t2"}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ratio", "[", "t_", "]"}], ":=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"kabck", "[", "t", "]"}], "/", 
      RowBox[{"Hbck", "[", "t", "]"}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "find", " ", "the", " ", "exact", " ", "values", " ", "with", " ", 
      "FindRoot"}], ",", " ", 
     RowBox[{
     "based", " ", "on", " ", "the", " ", "interval", " ", "from", " ", 
      "findBracket"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"start", " ", "power", " ", "spectrum", " ", "evolution"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ti", "=", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ratio", "[", "t", "]"}], "==", "whentostart"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"findBracket", "[", 
            RowBox[{"ratio", ",", "whentostart", ",", "kastarttime", ",", 
             RowBox[{"2", " ", "kastep"}]}], "]"}]}]}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"horizon", " ", "exit"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmatch", "=", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ratio", "[", "t", "]"}], "==", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"findBracket", "[", 
            RowBox[{"ratio", ",", "1", ",", "ti", ",", "kastep"}], "]"}]}]}], 
         "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"end", " ", "power", " ", "spectrum", " ", "evolution"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tf", "=", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ratio", "[", "t", "]"}], "==", "whentofinish"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"findBracket", "[", 
            RowBox[{
            "ratio", ",", "whentofinish", ",", "tmatch", ",", "kastep"}], 
            "]"}]}]}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
