Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"BackgroundEquation1", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Phi]", "\[Prime]\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"H", "[", 
           RowBox[{
            RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
            RowBox[{"Te", "[", "t", "]"}], ",", "t"}], "]"}]}], "+", 
         RowBox[{"\[CapitalUpsilon]", "[", 
          RowBox[{
           RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
           RowBox[{"Te", "[", "t", "]"}], ",", "t"}], "]"}]}], ")"}]}], 
      RowBox[{
       SuperscriptBox["\[Phi]", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "tref"}], "-", 
     RowBox[{
      RowBox[{"tref", "^", "2"}], " ", 
      RowBox[{
       SuperscriptBox["V", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"1", ",", "0"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
        RowBox[{"Te", "[", "t", "]"}]}], "]"}]}]}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BackgroundEquation2", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"er", "[", 
       RowBox[{"Te", "[", "t", "]"}], "]"}], ",", "t"}], "]"}], "==", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], 
      RowBox[{"H", "[", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
        RowBox[{"Te", "[", "t", "]"}], ",", "t"}], "]"}], "tref", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"er", "[", 
         RowBox[{"Te", "[", "t", "]"}], "]"}], "+", 
        RowBox[{"pr", "[", 
         RowBox[{"Te", "[", "t", "]"}], "]"}], "-", 
        RowBox[{
         RowBox[{"Te", "[", "t", "]"}], 
         RowBox[{"D", "[", " ", 
          RowBox[{
           RowBox[{"V", "[", 
            RowBox[{
             RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
             RowBox[{"Te", "[", "t", "]"}]}], "]"}], ",", 
           RowBox[{"Te", "[", "t", "]"}]}], "]"}]}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"Te", "[", "t", "]"}], 
      RowBox[{"D", "[", " ", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
          RowBox[{"Te", "[", "t", "]"}]}], "]"}], ",", 
        RowBox[{"Te", "[", "t", "]"}], ",", "t"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"\[CapitalUpsilon]", "[", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
        RowBox[{"Te", "[", "t", "]"}], ",", "t"}], "]"}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{
         SuperscriptBox["\[Phi]", "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}], "2"], "/", 
       "tref"}]}]}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"initialconditionsT\[Phi]", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Phi]", "[", "1", "]"}], "==", "\[Phi]ref"}], ",", 
     RowBox[{
      RowBox[{"Te", "[", "1", "]"}], "==", "Tref"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Phi]", "\[Prime]",
        MultilineFunction->None], "[", "1", "]"}], "==", 
      RowBox[{"\[Phi]dotref", "[", "Tref", "]"}]}]}], "}"}]}], 
  ";"}]}], "Input",
