 RowBox[{
  RowBox[{"MTm", "[", "i_", "]"}], ":=", 
  RowBox[{"Conjugate", "[", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Mm", "[", "i", "]"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
