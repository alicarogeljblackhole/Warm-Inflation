Cell[BoxData[
 RowBox[{
  RowBox[{"\[CurlyEpsilon]", "[", 
   RowBox[{"t_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "n"}], ")"}]}], "/", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "/@", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"Matr", "[", "t", "]"}], "]"}]}], "]"}]}]}]], "Input",
