Cell[BoxData[
 RowBox[{
  RowBox[{"Hlate", "[", "Te_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{"8", 
     RowBox[{"\[Pi]", "/", "3"}]}], "]"}], 
