         RowBox[{"SolMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"inds", ",", "4", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
       "denTSample"}], "+", 
      RowBox[{
       RowBox[{"SolMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"inds", ",", "4", ",", "4"}], "]"}], "]"}], "/", 
       RowBox[{"denTSample", "^", "2"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
