         RowBox[{"SolMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"inds", ",", "4", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
       "denTSample"}], "+", 
      RowBox[{
