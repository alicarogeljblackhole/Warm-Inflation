            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"\[Phi]bck", "[", "t", "]"}], "/", "fa"}], "]"}]}], 
           ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tfirst"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "For", " ", "matter", " ", "domination", " ", "simplification", " ", 
     "characretized", " ", "by", " ", "fast", " ", "inflaton", " ", 
     RowBox[{"oscillations", ".", " ", "Start"}], " ", "looking", " ", "for", 
     " ", "a", " ", "root", " ", "around", " ", "after", " ", "30", " ", 
     "sign", " ", 
     RowBox[{"switches", ".", " ", "Actually"}], " ", "have", " ", "the", " ",
      "solutiuon", " ", "ready", " ", "until", " ", "50", " ", "switches"}], ",",
     " ", 
    RowBox[{
    "just", " ", "to", " ", "be", " ", "sure", " ", "tswitch", " ", "will", " ",
      "be", " ", "within", " ", "tfirst", " ", "and", " ", "tswitch"}]}], 
   "*)"}]}]], "Input",
