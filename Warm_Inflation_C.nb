Cell["\<\
The  cells below first tries to find approximate value at which \
k/a=1000,1,10^-5 H, and then finds exact value. That is because FindRoot is \
slow without a decent guess. I assume that the modes exit the horizon before \
we get to the period of rapid oscillations. If that is not the case, the \
range of rats can be extended (replace tswitch with a bigger value).\
\>", "Text",
 CellChangeTimes->{{3.952508062355854*^9, 3.952508145089174*^9}, {
  3.952508175473284*^9, 3.952508330477824*^9}, {3.9558017730561113`*^9, 
  3.955801825911108*^9}, {3.9558021812964478`*^9, 3.955802270918602*^9}, {
  3.9996086923990717`*^9, 
  3.999608741534103*^9}},ExpressionUUID->"b107f2d5-b1b1-4886-ac57-\
75c6d1ad8364"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ratio", "[", "t_", "]"}], ":=", 
  RowBox[{"Evaluate", "[", 
   RowBox[{
    RowBox[{"katotal", "[", "t", "]"}], "/", 
    RowBox[{"Htotal", "[", "t", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rats", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ratio", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "tswitch"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"guess", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"FirstPosition", "[", 
     RowBox[{"rats", ",", 
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "<=", "x"}], "&"}], ")"}]}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ti", "=", 
   RowBox[{
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ratio", "[", "t", "]"}], "==", "whentostart"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"guess", "[", "whentostart", "]"}]}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmatch", "=", 
   RowBox[{
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ratio", "[", "t", "]"}], "==", "1"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"guess", "[", "1", "]"}]}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tf", "=", 
   RowBox[{
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ratio", "[", "t", "]"}], "==", "whentofinish"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"guess", "[", "whentofinish", "]"}]}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9290831801042128`*^9, 3.929083218863321*^9}, {
