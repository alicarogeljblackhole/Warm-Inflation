              RowBox[{"\[Phi]dotref", "^", "2"}], " ", 
              RowBox[{"\[CapitalUpsilon]", "[", "Tref", "]"}]}]}], ",", 
            "Tref"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sols", "=", 
         RowBox[{"Replace", "[", 
          RowBox[{
           RowBox[{"Tref", "/.", " ", "T0"}], ",", 
           RowBox[{
            RowBox[{"x_", "/;", 
             RowBox[{"AtomQ", "[", "x", "]"}]}], ":>", 
            RowBox[{"{", "x", "}"}]}]}], "]"}]}], ";", 
        RowBox[{"realParts", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", "#", "]"}], "&"}], "/@", "sols"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
             RowBox[{"0", "<", "#", "<", "1"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "realParts", "]"}], ">", "0"}], ",", 
          RowBox[{"First", "@", 
           RowBox[{"SortBy", "[", 
            RowBox[{"realParts", ",", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"#", "-", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "5"}]}]}], "]"}], "&"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<[Warning] Tref defaulted to 10^-5\>\"", "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"10", "^", 
            RowBox[{"-", "5"}]}]}]}], "]"}]}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"Select", "::", "normal"}], "}"}]}], "]"}], ";"}], "\n", 
