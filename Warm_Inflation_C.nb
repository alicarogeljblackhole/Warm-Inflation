Cell["\<\
Here we compute step sizes. Evaluate \[CurlyEpsilon] at t=ti,ti+1,...tf. Take \
its Log and interpolate, then extrapolate + exponentiate. 
If interpolation from step sizes 1 does not work, you can also make it finer \
like t=ti,ti+0.5,ti+1,...tf.
Logging is necessary to signal to Mathematica the step sizes must be positive.

The trick is being used because evaluating TimeSteps[ti,tf,2] is very slow \
otherwise, if you use \[CurlyEpsilon][t,n] directly.\
\>", "Text",
 CellChangeTimes->{{3.95803508397258*^9, 3.958035308998246*^9}, {
  3.999608891395096*^9, 
  3.999608925298498*^9}},ExpressionUUID->"dbcd06b4-f171-4c7b-84b0-\
5e4402a2fc41"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Quiet", "[", 
   RowBox[{
    RowBox[{"Interpolation", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Log", "[", 
          RowBox[{"\[CurlyEpsilon]", "[", 
           RowBox[{"i", ",", "n"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "ti", ",", 
         RowBox[{"tf", "+", "1"}], ",", "1"}], "}"}]}], "]"}], "]"}], "[", 
    "t", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CurlyEpsilon]approx1", "[", "t_", "]"}], ":=", 
  RowBox[{"Evaluate", "[", "%", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CurlyEpsilon]approx", "[", "t_", "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"\[CurlyEpsilon]approx1", "[", "t", "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.958033058443267*^9, 3.958033074330912*^9}, {
   3.958033181600595*^9, 3.958033219157803*^9}, {3.958033303924807*^9, 
