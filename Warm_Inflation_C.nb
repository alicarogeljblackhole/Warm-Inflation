Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"count", "=", "0"}], "}"}], ",", 
     RowBox[{"bckfull", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"BackgroundEquation1", "[", "t", "]"}], ",", 
          RowBox[{"BackgroundEquation2", "[", "t", "]"}], ",", 
          "initialconditionsT\[Phi]", ",", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Phi]", "[", "t", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"count", "==", "30"}], ",", 
               RowBox[{"tfirst", "=", "t"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"count", "==", "50"}], ",", 
               RowBox[{
                RowBox[{"tmax", "=", "t"}], 
                ";", "\"\<StopIntegration\>\""}]}], "]"}]}]}], "]"}]}], "}"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "Te", ",", "ka"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "1", ",", 
          RowBox[{"10", "^", "9"}]}], "}"}], ",", 
        RowBox[{"AccuracyGoal", "->", "50"}], ",", 
        RowBox[{"PrecisionGoal", "->", "10"}], ",", 
        RowBox[{"MaxSteps", "->", 
         RowBox[{"10", "^", "9"}]}], ",", 
        RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}]}]}], "]"}], ";"}], 
