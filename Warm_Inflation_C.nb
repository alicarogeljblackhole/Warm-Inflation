Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tswitch", "=", 
    RowBox[{"Quiet", "@", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Phi]dot", "[", "t", "]"}], "==", 
