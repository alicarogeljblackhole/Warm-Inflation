Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"finding", " ", "maximum", " ", "T"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Ttguess", "=", 
    RowBox[{"100", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{
         RowBox[{"Reap", "[", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "=", "30"}], ",", "val"}], "}"}], ",", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"i", "<=", "te"}], ",", 
              RowBox[{
               RowBox[{"val", "=", 
                RowBox[{"Tdot", "[", "i", "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"val", "<", "0"}], ",", 
                 RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Sow", "[", "val", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"i", "+=", "100"}], ";"}]}], "]"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], "-", "1"}], ")"}]}]}],
    ";"}]}]], "Input",
 CellChangeTimes->{{3.958031873791278*^9, 3.958031927661682*^9}, {
