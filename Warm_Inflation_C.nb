Cell[BoxData[{
 RowBox[{
  RowBox[{"kafull", "[", "t_", "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kabck", "[", "t", "]"}], ",", 
       RowBox[{"t", "<=", "tswitch"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kabcklate", "[", "t", "]"}], ",", 
       RowBox[{"tswitch", "<", "t"}]}], "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"katot", "[", "t_", "]"}], ":=", 
  RowBox[{"kafull", "/@", 
   RowBox[{"{", "t", "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"katotal", "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{"katot", "[", "t", "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.955533839147434*^9, 3.955533851682033*^9}, {
  3.9569921066061974`*^9, 3.956992127381927*^9}},
