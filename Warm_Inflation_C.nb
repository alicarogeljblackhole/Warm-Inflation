Cell[BoxData[
 RowBox[{
  RowBox[{"slowy", "[", "tswitch_", "]"}], ":=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["e\[Phi]", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             RowBox[{"\[Kappa]T", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"\[Pi]", " ", "mpl", " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{
                   RowBox[{"xT", "[", "t", "]"}], "/", "4"}], "]"}]}], " ", 
                ")"}], "^", "3"}]}], "+", 
             RowBox[{"\[Kappa]m", " ", 
              RowBox[{"m", "^", "3"}]}]}], 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"4", "\[Pi]"}], ")"}], "^", "3"}], " ", 
             RowBox[{"fa", "^", "2"}]}]], ")"}]}], " ", "tref", " ", 
         RowBox[{"e\[Phi]", "[", "t", "]"}]}], "-", 
        RowBox[{"3", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"8", 
             FractionBox["\[Pi]", "3"]}], "]"}], 
           FractionBox[
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"e\[Phi]", "[", "t", "]"}], "+", 
              RowBox[{"gstar", " ", 
               RowBox[{"\[Pi]", "^", "2"}], " ", 
               FractionBox[
                RowBox[{
                 RowBox[{"mpl", "^", "4"}], " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{"xT", "[", "t", "]"}], "]"}]}], "30"]}]}], "]"}], 
            "mpl"]}], ")"}], 
         RowBox[{"e\[Phi]", "[", "t", "]"}], "tref"}]}]}], ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox["xT", "\[Prime]",
         MultilineFunction->None], "[", "t", "]"}], "==", 
       RowBox[{"30", "tref", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{
               RowBox[{"\[Kappa]T", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"\[Pi]", " ", "mpl", " ", 
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"xT", "[", "t", "]"}], "/", "4"}], "]"}]}], " ", 
                  ")"}], "^", "3"}]}], "+", 
               RowBox[{"\[Kappa]m", " ", 
                RowBox[{"m", "^", "3"}]}]}], 
              RowBox[{
               RowBox[{
