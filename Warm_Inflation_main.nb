Cell[BoxData[
 RowBox[{
  RowBox[{"H", "[", 
   RowBox[{"\[Phi]_", ",", "Te_", ",", "depvar_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "mpl"], "2", " ", 
   SqrtBox[
    FractionBox[
     RowBox[{"2", " ", "\[Pi]"}], "3"]], " ", 
   RowBox[{"\[Sqrt]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"er", "[", "Te", "]"}], "+", 
      RowBox[{"V", "[", 
       RowBox[{"\[Phi]", ",", "Te"}], "]"}], "+", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"\[Phi]", ",", "depvar"}], "]"}], "^", "2"}], "/", 
        RowBox[{"tref", "^", "2"}]}]}], "-", 
      RowBox[{"Te", " ", 
       RowBox[{
        SuperscriptBox["V", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"0", ",", "1"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"\[Phi]", ",", "Te"}], "]"}]}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.990241407892515*^9, 3.990241413978681*^9}},
