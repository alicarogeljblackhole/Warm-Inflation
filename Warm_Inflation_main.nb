      RowBox[{"kabck", "[", "t", "]"}], "/", 
      RowBox[{"Hbck", "[", "t", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
