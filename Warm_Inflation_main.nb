      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"horizon", " ", "exit"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tmatch", "=", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ratio", "[", "t", "]"}], "==", "1"}], ",", 
        RowBox[{"{", 
