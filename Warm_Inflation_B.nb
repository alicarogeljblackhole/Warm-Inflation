          MultilineFunction->None], "[", "start", "]"}], "+", 
        RowBox[{"I", " ", "0", " ", "tref"}]}], ")"}], " ", "2", "\[Pi]"}]]}], 
   RowBox[{"kabck", "[", "start", "]"}]}]}], "\[IndentingNewLine]", 
