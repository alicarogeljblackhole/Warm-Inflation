Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PRv", "=", 
    RowBox[{"Re", "@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SolMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"inds", ",", "1", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SolMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"inds", ",", "1", ",", "3"}], "]"}], "]"}], "+", 
          RowBox[{"SolMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"inds", ",", "3", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
        "denvSample"}], "+", 
       RowBox[{
        RowBox[{"SolMatrix", "[", 
         RowBox[{"[", 
          RowBox[{"inds", ",", "3", ",", "3"}], "]"}], "]"}], "/", 
        RowBox[{"denvSample", "^", "2"}]}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"PRT", "=", 
   RowBox[{"Re", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"SolMatrix", "[", 
       RowBox[{"[", 
        RowBox[{"inds", ",", "1", ",", "1"}], "]"}], "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SolMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"inds", ",", "1", ",", "4"}], "]"}], "]"}], "+", 
         RowBox[{"SolMatrix", "[", 
          RowBox[{"[", 
           RowBox[{"inds", ",", "4", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
       "denTSample"}], "+", 
      RowBox[{
       RowBox[{"SolMatrix", "[", 
        RowBox[{"[", 
         RowBox[{"inds", ",", "4", ",", "4"}], "]"}], "]"}], "/", 
       RowBox[{"denTSample", "^", "2"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PR\[Phi]", "=", 
   RowBox[{"Re", "@", 
    RowBox[{"SolMatrix", "[", 
     RowBox[{"[", 
      RowBox[{"inds", ",", "1", ",", "1"}], "]"}], "]"}]}]}], ";"}]}], "Input",
