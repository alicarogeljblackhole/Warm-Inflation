    RowBox[{"\[CapitalOmega]ks", "[", 
     RowBox[{"[", "i", "]"}], "]"}], "/", "tref"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SolMatrix", "=", 
