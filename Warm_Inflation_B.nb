Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"standard", " ", "thermodynamics"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eav", "[", 
     RowBox[{"\[Phi]_", ",", "Te_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"er", "[", "Te", "]"}], "+", 
     RowBox[{"V", "[", 
      RowBox[{"\[Phi]", ",", "Te"}], "]"}], "-", 
     RowBox[{"Te", " ", 
      RowBox[{
       SuperscriptBox["V", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "1"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"\[Phi]", ",", "Te"}], "]"}]}]}]}], 
   RowBox[{"(*", 
    RowBox[{"average", " ", "energy", " ", "density"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pav", "[", 
     RowBox[{"\[Phi]_", ",", "Te_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"pr", "[", "Te", "]"}], "-", 
     RowBox[{"V", "[", 
      RowBox[{"\[Phi]", ",", "Te"}], "]"}], 
     RowBox[{"(*", 
