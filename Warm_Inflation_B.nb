324f273af09b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Quiet", "[", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"count", "=", "0"}], "}"}], ",", 
     RowBox[{"bckfull", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"BackgroundEquation1", "[", "t", "]"}], ",", 
          RowBox[{"BackgroundEquation2", "[", "t", "]"}], ",", 
          "initialconditionsT\[Phi]", ",", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"1", "/", "2"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{
                    SuperscriptBox["\[Phi]", "\[Prime]",
                    MultilineFunction->None], "[", "t", "]"}], "2"], "/", 
                   RowBox[{"tref", "^", "2"}]}], ")"}]}], "+", 
                RowBox[{"V", "[", 
                 RowBox[{
                  RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
                  RowBox[{"Te", "[", "t", "]"}]}], "]"}], "-", 
                RowBox[{
                 RowBox[{"Te", "[", "t", "]"}], 
                 RowBox[{
                  SuperscriptBox["V", 
                   TagBox[
                    RowBox[{"(", 
                    RowBox[{"0", ",", "1"}], ")"}],
                    Derivative],
                   MultilineFunction->None], "[", 
                  RowBox[{
                   RowBox[{"\[Phi]", "[", "t", "]"}], ",", 
                   RowBox[{"Te", "[", "t", "]"}]}], "]"}]}]}], ")"}], "/", 
              RowBox[{"er", "[", 
               RowBox[{"Te", "[", "t", "]"}], "]"}]}], "<=", 
             RowBox[{"10", "^", 
              RowBox[{"(", 
               RowBox[{"-", "3"}], ")"}]}]}], 
            ",", "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
