Cell[BoxData[{
 RowBox[{
  RowBox[{"Mp", "[", "i_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Mp", "[", "i", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c1sp", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"c2s", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"c3s", "[", 
