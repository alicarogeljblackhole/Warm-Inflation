  3.9868761904203367`*^9}},ExpressionUUID->"ffa2d090-92c7-470a-8120-\
bef84c393351"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Quiet", "[", 
    RowBox[{
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"kal", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Hbck", "[", "t", "]"}]}], "tref"}]}], ",", 
         RowBox[{
          RowBox[{"kal", "[", "te", "]"}], "==", 
          RowBox[{"Log", "[", "kamode", "]"}]}]}], "}"}], ",", "kal", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "1", ",", "te"}], "}"}], ",", 
       RowBox[{"PrecisionGoal", "->", "10"}], ",", 
       RowBox[{"AccuracyGoal", "->", "10"}], ",", 
       RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "]"}], "[", "t", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kabck1", "[", "t_", "]"}], ":=", 
  RowBox[{"Evaluate", "[", "%", "]"}]}]}], "Input",
 CellChangeTimes->{{3.960267768037365*^9, 3.960267843842275*^9}, {
   3.960267877842668*^9, 3.9602678923694057`*^9}, {3.960267940772147*^9, 
   3.960267978792403*^9}, {3.96026814507038*^9, 3.960268168765154*^9}, {
