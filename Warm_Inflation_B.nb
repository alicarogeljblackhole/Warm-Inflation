Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"find", " ", "solutions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Id", "=", 
          RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "}"}], ",", 
