Cell[BoxData[
 RowBox[{
  RowBox[{"kabck", "[", "t_", "]"}], ":=", 
  RowBox[{"Evaluate", "[", 
   RowBox[{"Exp", "[", 
    RowBox[{"kabck1", "[", "t", "]"}], "]"}], "]"}], 
  RowBox[{"(*", 
