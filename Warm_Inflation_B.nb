Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Tref", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tref", "=", 
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", 
       FractionBox["3", 
        RowBox[{"8", "\[Pi]", " ", 
         RowBox[{"V", "[", 
          RowBox[{"\[Phi]ref", ",", "Tref"}], "]"}]}]], "]"}], "mpl"}], ",", 
     "50"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Href", "=", 
    RowBox[{"1", "/", "tref"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"H", " ", "at", " ", "ref", " ", "time"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalUpsilon]ref", "[", "Tref_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[CapitalUpsilon]", "[", 
     RowBox[{"\[Phi]", ",", "Te", ",", "depvar"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Te", "->", "Tref"}], ",", 
      RowBox[{"\[Phi]", "->", "\[Phi]ref"}], ",", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{"\[Phi]", ",", "Te", ",", "depvar"}], "]"}], "->", "Href"}]}],
      "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]dotref", "[", "Tref_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", " ", 
     RowBox[{
      SuperscriptBox["V", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"1", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"\[Phi]ref", ",", "Tref"}], "]"}]}], 
    RowBox[{"tref", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", "Href"}], " ", "+", 
       RowBox[{"\[CapitalUpsilon]ref", "[", "Tref", "]"}]}], ")"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.987141546687302*^9, 3.987141588510397*^9}, {
  3.987141868457388*^9, 3.987141869356389*^9}, {3.987141927624176*^9, 
  3.987141959496662*^9}, {3.9871419974985933`*^9, 3.987142025422682*^9}, {
  3.987142057118024*^9, 3.9871420934371977`*^9}, {3.987142323757389*^9, 
