          RowBox[{"Hs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], " ", 
        RowBox[{"tref", "^", "3"}]}], ",", "0", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Hs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], 
        RowBox[{
         RowBox[{"\[Phi]dots", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}]}], "}"}]}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Noise", "[", "i_", "]"}], ":=", 
