        RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MT", "[", "i_", "]"}], ":=", 
  RowBox[{"Conjugate", "[", 
   RowBox[{"Transpose", "[", 
    RowBox[{"M", "[", "i", "]"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ncoeff", "[", "i_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Ncoeff", "[", "i", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"tref", "^", "4"}], " ", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Hs", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"tref", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Phi]dots", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "+", 
              RowBox[{"I", " ", "\[Delta]", " ", "tref"}]}], ")"}]}]}], "]"}],
          "^", "2"}]}], ",", "0", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"Hs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "^", "2"}]}], " ", 
        RowBox[{"tref", "^", "3"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"-", 
